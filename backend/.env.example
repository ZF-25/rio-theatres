PORT=5000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://user:password@localhost:5432/rio_theaters
# TMDB "API Read Access Token" (the long one); the short API key also works
TMDB_READ_ACCESS_TOKEN=
# Stripe TEST mode only (Sandbox). Never commit real values, never use sk_live_.
# Secret key from https://dashboard.stripe.com/apikeys (starts with sk_test_)
STRIPE_SECRET_KEY=
# Printed by `stripe listen` (starts with whsec_); on Render: the Dashboard webhook's secret
STRIPE_WEBHOOK_SECRET=
# true only for tests/demos: allows paymentMethod "simulated" (free tickets!)
ALLOW_SIMULATED_PAYMENT=false
