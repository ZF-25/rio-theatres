# Frontend API address.
# Vite forwards /api requests to the local backend on port 5000.
VITE_API_BASE_URL=/api/v1

# Full demo by default.
# Supported values: demo or api.
VITE_DATA_MODE=demo
VITE_AUTH_MODE=demo
VITE_STAFF_MODE=demo
VITE_BOOKING_MODE=demo

# API feature availability.
# These flags do not disable features in demo mode.
# Enable only after the corresponding integration is verified.
VITE_API_OWNER_OVERVIEW=false
VITE_API_OWNER_SCREENINGS=false
VITE_API_OWNER_BOOKINGS=false
VITE_API_STAFF_RESERVATIONS=false

# Keep disabled while Stripe checkout integration is being completed.
VITE_API_CUSTOMER_BOOKING=false